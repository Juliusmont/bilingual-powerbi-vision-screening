}
Param Sex = {
    ("Sexe", NAMEOF ( 'DimSex'[Sex_FR] ), 0, "FR"),
    ("Sex",  NAMEOF ( 'DimSex'[Sex_EN] ), 1, "EN")
}
Param Age Band = {
    ("Tranche d'âge", NAMEOF ( 'DimAgeBand'[AgeBand_FR] ), 0, "FR"),
