// =====================================================================
// ROW-LEVEL SECURITY (Modeling > Manage roles), filter on table DimRegion
// =====================================================================
/*
Role "Region - Plateaux" (static):   [RegionCode] = "PLA"
Role "Region - Maritime" (static):   [RegionCode] = "MAR"
Role "Dynamic by user":
    [RegionCode]
        IN CALCULATETABLE (
            VALUES ( SecurityUserRegion[RegionCode] ),
            SecurityUserRegion[UserEmail] = USERPRINCIPALNAME ()
        )
*/

// ---------- Folder: 3 Clinical analysis (bilingual axes) --------------
// Axes come from the calculated tables 'Lbl Cat' / 'Lbl Cat Legend' (one row per category x language,
// related to DimLanguage). Each measure returns BLANK on rows of the non-selected language, so the axis
// shows labels in the selected language only. Rates hidden below 10 students (small-cell rule).
// 'Lbl Cat' = UNION of SELECTCOLUMNS over DimDiagnosis groups / DimVACategory / DimSymptom / DimScreenTime
//   (Domain, CatKey, LanguageCode, Label); 'Lbl Cat Legend' = FILTER ( 'Lbl Cat', Domain = "DIAG" ).
Diagnosis Share (Cat) =
VAR k = SELECTEDVALUE ( 'Lbl Cat'[CatKey] )
RETURN
    IF (
        SELECTEDVALUE ( 'Lbl Cat'[LanguageCode] ) = [Selected Language] && NOT ISBLANK ( k ) && [Students Screened] >= 10,
        CALCULATE ( [Diagnosis Share], DimDiagnosis[GroupSortOrder] = k )
    )

VA Share (Cat) =
VAR k = SELECTEDVALUE ( 'Lbl Cat'[CatKey] )
RETURN
    IF (
        SELECTEDVALUE ( 'Lbl Cat'[LanguageCode] ) = [Selected Language] && NOT ISBLANK ( k ) && [Students Screened] >= 10,
        DIVIDE ( CALCULATE ( [Eyes Examined], FactEyeExam[VACategoryKey] = k ), [Eyes Examined] )
    )

Symptom Rate (Cat) =
VAR k = SELECTEDVALUE ( 'Lbl Cat'[CatKey] )
RETURN
    IF (
        SELECTEDVALUE ( 'Lbl Cat'[LanguageCode] ) = [Selected Language] && NOT ISBLANK ( k ) && [Students Screened] >= 10,
        CALCULATE ( [Symptom Rate], DimSymptom[SymptomKey] = k )
    )

Eyes by Screen Time (Cat) =
VAR ks = SELECTEDVALUE ( 'Lbl Cat'[CatKey] )
VAR kd = SELECTEDVALUE ( 'Lbl Cat Legend'[CatKey] )
RETURN
    IF (
        SELECTEDVALUE ( 'Lbl Cat'[LanguageCode] ) = [Selected Language]
            && SELECTEDVALUE ( 'Lbl Cat Legend'[LanguageCode] ) = [Selected Language]
            && NOT ISBLANK ( ks ) && NOT ISBLANK ( kd ),
        CALCULATE ( [Eyes Examined], FactScreening[ScreenTimeKey] = ks, DimDiagnosis[GroupSortOrder] = kd )
    )

Color Diagnosis Group =
VAR kl = SELECTEDVALUE ( 'Lbl Cat Legend'[CatKey] )
VAR k = COALESCE ( kl, SELECTEDVALUE ( 'Lbl Cat'[CatKey] ) )
VAR okAxis = SELECTEDVALUE ( 'Lbl Cat'[LanguageCode] ) = [Selected Language]
VAR okLegend = ISBLANK ( kl ) || SELECTEDVALUE ( 'Lbl Cat Legend'[LanguageCode] ) = [Selected Language]
RETURN
    IF (
        okAxis && okLegend && NOT ISBLANK ( k ),
        SWITCH ( k, 1, "#2A78D6", 2, "#C2410C", 3, "#1BAF7A", 4, "#6250D6", "#8A94A6" )
    )

Color VA Ramp =
VAR k = SELECTEDVALUE ( 'Lbl Cat'[CatKey] )
RETURN
    IF (
        SELECTEDVALUE ( 'Lbl Cat'[LanguageCode] ) = [Selected Language] && NOT ISBLANK ( k ),
        SWITCH ( k, 1, "#CDE2FB", 2, "#86B6EF", 3, "#3987E5", 4, "#1C5CAB", 5, "#104281", "#8A94A6" )
    )

Lbl Note Assoc = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "note_assoc", Labels[LanguageCode], [Selected Language] )

Alt Text Diagnosis Chart = "Bars: share of examined eyes by diagnosis group / Barres : répartition des yeux examinés par groupe de diagnostic"
Alt Text VA Chart = "Columns: share of examined eyes by visual acuity category / Colonnes : répartition des yeux par catégorie d'acuité visuelle"
Alt Text Symptom Chart = "Bars: share of students reporting each symptom / Barres : proportion d'élèves par signe fonctionnel"
Alt Text Screen Chart = "100% stacked columns: diagnosis mix by screen time; association, not causation / Colonnes empilées : diagnostics selon le temps d'écran ; association, pas causalité"

// ---------- Folder: 0 Language (table headers / chart legend labels, page 2) ----------
Lbl Col Prefecture = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "col_prefecture", Labels[LanguageCode], [Selected Language] )
Lbl Col Rank = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "col_rank", Labels[LanguageCode], [Selected Language] )
Lbl Legend Target = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "legend_target", Labels[LanguageCode], [Selected Language] )
