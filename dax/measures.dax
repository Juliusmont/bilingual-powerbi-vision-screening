// =====================================================================
// Bilingual School Vision Screening - DAX measures
// Create a table "_Measures" (Enter data, one empty column) and add the
// measures below. Display folders are suggested in comments.
// =====================================================================

// ---------- Folder: 0 Language ----------------------------------------
Selected Language =
SELECTEDVALUE (
    DimLanguage[LanguageCode],
    IF ( LEFT ( USERCULTURE (), 2 ) = "fr", "FR", "EN" )   // default = viewer's browser culture
)

Selected Locale = IF ( [Selected Language] = "FR", "fr-FR", "en-US" )

// One measure per UI label (titles, KPI captions). Same pattern for every LabelKey in Labels.csv
Lbl Title Exec = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "title_exec", Labels[LanguageCode], [Selected Language] )
Lbl Title Analysis = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "title_analysis", Labels[LanguageCode], [Selected Language] )
Lbl Screened = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "kpi_screened", Labels[LanguageCode], [Selected Language] )
Lbl Need = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "kpi_need", Labels[LanguageCode], [Selected Language] )
Lbl Impairment = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "kpi_impairment", Labels[LanguageCode], [Selected Language] )
Lbl Target = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "kpi_target", Labels[LanguageCode], [Selected Language] )
Lbl Chart Region = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "chart_region", Labels[LanguageCode], [Selected Language] )
Lbl Chart Rank = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "chart_rank", Labels[LanguageCode], [Selected Language] )
Lbl Chart Trend = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "chart_trend", Labels[LanguageCode], [Selected Language] )
Lbl Chart Diag = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "chart_diag", Labels[LanguageCode], [Selected Language] )
Lbl Chart Diag Share = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "chart_diag_share", Labels[LanguageCode], [Selected Language] )
Lbl Chart Symptom = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "chart_symptom", Labels[LanguageCode], [Selected Language] )
Lbl Chart Screen = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "chart_screen", Labels[LanguageCode], [Selected Language] )
Lbl Note Synthetic = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "note_synthetic", Labels[LanguageCode], [Selected Language] )
Lbl KPI YoY = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "kpi_yoy", Labels[LanguageCode], [Selected Language] )
Lbl Slicer Language = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "slicer_language", Labels[LanguageCode], [Selected Language] )
Lbl Slicer Region = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "slicer_region", Labels[LanguageCode], [Selected Language] )
Lbl Slicer Campaign = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "slicer_campaign", Labels[LanguageCode], [Selected Language] )
Lbl Note DQ = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "note_dq", Labels[LanguageCode], [Selected Language] )
Lbl Nav About = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "nav_about", Labels[LanguageCode], [Selected Language] )
Lbl Nav Exec = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "nav_exec", Labels[LanguageCode], [Selected Language] )
Lbl Nav Analysis = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "nav_analysis", Labels[LanguageCode], [Selected Language] )
Lbl Nav Quality = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "nav_quality", Labels[LanguageCode], [Selected Language] )
Lbl Title Quality = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "title_quality", Labels[LanguageCode], [Selected Language] )
Lbl Title About = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "title_about", Labels[LanguageCode], [Selected Language] )
Lbl Narrative Title = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "narrative_title", Labels[LanguageCode], [Selected Language] )
Lbl Section Coverage = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "section_coverage", Labels[LanguageCode], [Selected Language] )
Lbl Section Needs = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "section_needs", Labels[LanguageCode], [Selected Language] )
Lbl Section Geo = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "section_geo", Labels[LanguageCode], [Selected Language] )
Lbl KPI Uncorrected = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "kpi_uncorrected", Labels[LanguageCode], [Selected Language] )
Lbl Chart VA = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "chart_va", Labels[LanguageCode], [Selected Language] )
Lbl Chart DQ = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "chart_dq", Labels[LanguageCode], [Selected Language] )
Lbl Note Population = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "note_population", Labels[LanguageCode], [Selected Language] )
Lbl Note Small Cells = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "note_small_cells", Labels[LanguageCode], [Selected Language] )
Lbl Footer Built = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "footer_built", Labels[LanguageCode], [Selected Language] )
Lbl About Intro = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "about_intro", Labels[LanguageCode], [Selected Language] )
Lbl About Def Need = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "about_def_need", Labels[LanguageCode], [Selected Language] )
Lbl About Def Uncorrected = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "about_def_uncorrected", Labels[LanguageCode], [Selected Language] )
Lbl About Def Impairment = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "about_def_impairment", Labels[LanguageCode], [Selected Language] )
Lbl About Def Target = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "about_def_target", Labels[LanguageCode], [Selected Language] )
Lbl About Howto Lang = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "about_howto_lang", Labels[LanguageCode], [Selected Language] )
Lbl About Author = LOOKUPVALUE ( Labels[Text], Labels[LabelKey], "about_author", Labels[LanguageCode], [Selected Language] )

// ---------- Folder: 0 Language (bold-keyword split, About page definitions) --------
Lbl About Def Need Body =
VAR t = [Lbl About Def Need]
VAR p = FIND ( ":", t, 1, 0 )
RETURN IF ( p > 0, TRIM ( MID ( t, p + 1, 9999 ) ), t )

Lbl About Def Uncorrected Body =
VAR t = [Lbl About Def Uncorrected]
VAR p = FIND ( ":", t, 1, 0 )
RETURN IF ( p > 0, TRIM ( MID ( t, p + 1, 9999 ) ), t )

Lbl About Def Impairment Body =
VAR t = [Lbl About Def Impairment]
VAR p = FIND ( ":", t, 1, 0 )
RETURN IF ( p > 0, TRIM ( MID ( t, p + 1, 9999 ) ), t )

Lbl About Def Target Body =
VAR t = [Lbl About Def Target]
VAR p = FIND ( ":", t, 1, 0 )
RETURN IF ( p > 0, TRIM ( MID ( t, p + 1, 9999 ) ), t )

// ---------- Folder: 1 Core KPIs ---------------------------------------
Students Screened = COUNTROWS ( FactScreening )

Eyes Examined = COUNTROWS ( FactEyeExam )

// "Need for correction" = the examiner proposed a non-zero prescription in at least one eye
// (data-driven definition, avoids the misleading ~99% "any refractive error" rate)
Students Needing Correction =
CALCULATE (
    DISTINCTCOUNT ( FactEyeExam[StudentKey] ),
    FactEyeExam[SphereRx] <> 0 || FactEyeExam[CylinderRx] <> 0
)

Correction Need Rate = DIVIDE ( [Students Needing Correction], [Students Screened] )

Uncorrected Need =
CALCULATE ( [Students Needing Correction], FactScreening[WearsCorrection] = 0 )

Uncorrected Need Rate = DIVIDE ( [Uncorrected Need], [Students Needing Correction] )

// Visual impairment in at least one eye (VA category Mild or worse)
Students With Impairment =
CALCULATE ( DISTINCTCOUNT ( FactEyeExam[StudentKey] ), FactEyeExam[VACategoryKey] >= 2 )

Impairment Rate = DIVIDE ( [Students With Impairment], [Students Screened] )

Screen Exposure Rate =
DIVIDE ( CALCULATE ( [Students Screened], FactScreening[ScreenTimeKey] > 0 ), [Students Screened] )

// Share of a diagnosis among examined eyes (use with a diagnosis field parameter on the axis)
Diagnosis Share =
DIVIDE ( [Eyes Examined], CALCULATE ( [Eyes Examined], REMOVEFILTERS ( DimDiagnosis ) ) )

Students With Symptom = DISTINCTCOUNT ( BridgeSymptom[StudentKey] )
Symptom Rate = DIVIDE ( [Students With Symptom], [Students Screened] )

// ---------- Folder: 2 Time intelligence & targets ---------------------
// Mark DimDate as date table (Date column) before using these measures
Students Screened PY = CALCULATE ( [Students Screened], SAMEPERIODLASTYEAR ( DimDate[Date] ) )

Students Screened YoY % =
DIVIDE ( [Students Screened] - [Students Screened PY], [Students Screened PY] )

Students Screened YTD = TOTALYTD ( [Students Screened], DimDate[Date] )

Correction Need Rate PY = CALCULATE ( [Correction Need Rate], SAMEPERIODLASTYEAR ( DimDate[Date] ) )

Correction Need Rate Change (pts) =
IF ( NOT ISBLANK ( [Correction Need Rate PY] ), ( [Correction Need Rate] - [Correction Need Rate PY] ) * 100 )

Target Students = SUM ( FactTarget[TargetStudents] )

Target Achievement % = DIVIDE ( [Students Screened], [Target Students] )

// ---------- Folder: 3 Ranking -----------------------------------------
Prefecture Rank (Need Rate) =
IF (
    ISINSCOPE ( DimPrefecture[Prefecture] ),
    RANKX ( ALLSELECTED ( DimPrefecture[Prefecture] ), [Correction Need Rate], , DESC, DENSE )
)

// ---------- Folder: 4 Formatted captions (locale-aware) ---------------
KPI Need Subtitle =
VAR d = [Correction Need Rate Change (pts)]
RETURN
    IF (
        ISBLANK ( d ),
        IF ( [Selected Language] = "FR", "Première campagne", "First campaign" ),
        FORMAT ( d, "+0.0;-0.0;0.0", [Selected Locale] )
            & IF ( [Selected Language] = "FR", " pts vs campagne précédente", " pts vs previous campaign" )
    )

KPI Screened Caption =
FORMAT ( [Students Screened], "#,0", [Selected Locale] )
    & IF ( [Selected Language] = "FR", " élèves dépistés", " students screened" )

Color YoY =
VAR d = [Students Screened YoY %]
RETURN IF ( ISBLANK ( d ), "#4A5873", IF ( d >= 0, "#0CA30C", "#D03B3B" ) )

KPI Screened YoY Caption =
VAR d = [Students Screened YoY %]
RETURN
    IF (
        ISBLANK ( d ),
        IF ( [Selected Language] = "FR", "Première campagne", "First campaign" ),
        ( IF ( d >= 0, "▲ ", "▼ " ) )
            & FORMAT ( d, "+0.0%;-0.0%;0.0%", [Selected Locale] )
            & IF ( [Selected Language] = "FR", " vs campagne précédente", " vs previous campaign" )
    )

Color Target Achievement =
VAR a = [Target Achievement %]
RETURN
    IF (
        ISBLANK ( a ), "#4A5873",
        IF ( a >= 0.95, "#0CA30C", IF ( a >= 0.85, "#FAB219", "#D03B3B" ) )
    )

KPI Target Caption =
FORMAT ( [Target Students], "#,0", [Selected Locale] )
    & IF ( [Selected Language] = "FR", " élèves ciblés", " students targeted" )

KPI Uncorrected Caption =
IF ( [Selected Language] = "FR", "Parmi les besoins de correction", "Of those needing correction" )

KPI Impairment Caption =
IF ( [Selected Language] = "FR", "Acuité légère ou pire, au moins un œil", "Mild acuity or worse, at least one eye" )

// Fixed accent colour for the region bar chart (single series; see guidebook palette slot 1)
Color Region Bar = "#2A78D6"

// Selected campaign year (header slicer) or an "all campaigns" fallback.
// Reads DimDate[Year] directly: a field-parameter column cannot be used in a measure (composite-key error).
Header Campaign Pill =
VAR yr = SELECTEDVALUE ( DimDate[Year] )
RETURN
    IF (
        ISBLANK ( yr ),
        IF ( [Selected Language] = "FR", "Toutes campagnes", "All campaigns" ),
        IF ( [Selected Language] = "FR", "Campagne " & yr, yr & " campaign" )
    )

// Overview page narrative banner headline
Narrative Headline =
VAR need = [Correction Need Rate]
VAR screened = [Students Screened]
RETURN
    IF (
        [Selected Language] = "FR",
        FORMAT ( need, "0.0%", "fr-FR" ) & " des " & FORMAT ( screened, "#,0", "fr-FR" )
            & " élèves dépistés ont besoin d'une correction visuelle.",
        FORMAT ( need, "0.0%", "en-US" ) & " of " & FORMAT ( screened, "#,0", "en-US" )
            & " students screened need a vision correction."
    )

// Accessibility: dynamic alt text (Format > General > Alt text > fx)
Alt Text Region Chart =
IF (
    [Selected Language] = "FR",
    "Graphique à barres du taux de besoin de correction par région. Taux national : "
        & FORMAT ( [Correction Need Rate], "0.0 %", "fr-FR" ),
    "Bar chart of the need-for-correction rate by region. National rate: "
        & FORMAT ( [Correction Need Rate], "0.0%", "en-US" )
)

// ---------- Folder: 5 Privacy (small-cell suppression) ----------------
// Hide rates computed on fewer than 10 students (re-identification risk on health data)
Correction Need Rate (Safe) =
IF ( [Students Screened] < 10, BLANK (), [Correction Need Rate] )

// ---------- Folder: 6 Data integrity checks ---------------------------
DQ Implausible Cylinder = COUNTROWS ( FILTER ( FactEyeExam, ABS ( FactEyeExam[CylinderRx] ) > 6 ) )

DQ Plus Cylinder Convention =
COUNTROWS ( FILTER ( FactEyeExam, FactEyeExam[CylinderRx] > 0 && FactEyeExam[CylinderRx] <= 6 ) )

DQ Missing Visual Acuity = COUNTROWS ( FILTER ( FactEyeExam, ISBLANK ( FactEyeExam[VA_10] ) ) )

// COALESCE(...,0) because COUNTROWS returns BLANK (not 0) when the filtered table is empty,
// which would show as an empty cell instead of a reassuring "0" on a DQ card.
DQ Students Without Two Eyes =
COALESCE ( COUNTROWS ( FILTER ( FactScreening, CALCULATE ( COUNTROWS ( FactEyeExam ) ) <> 2 ) ), 0 )

DQ Symptom Inconsistency =
COALESCE (
    COUNTROWS (
        FILTER ( FactScreening, FactScreening[HasSymptoms] = 0 && CALCULATE ( COUNTROWS ( BridgeSymptom ) ) > 0 )
    ),
    0
)

DQ Issues Total =
[DQ Implausible Cylinder] + [DQ Plus Cylinder Convention] + [DQ Missing Visual Acuity]
    + [DQ Students Without Two Eyes] + [DQ Symptom Inconsistency]

DQ Status =
IF (
    [DQ Issues Total] = 0,
    IF ( [Selected Language] = "FR", "✓ Aucune anomalie", "✓ No issues" ),
    "⚠ " & FORMAT ( [DQ Issues Total], "#,0", [Selected Locale] )
        & IF ( [Selected Language] = "FR", " anomalies à vérifier", " issues to review" )
)


// =====================================================================
// FIELD PARAMETERS (Modeling > New parameter > Fields), then edit the DAX
// to add a 4th column = language code, rename it LanguageCode and create a
// relationship DimLanguage[LanguageCode] (1) -> (*) Param[LanguageCode]
// =====================================================================
// IMPLEMENTED (page 2 - Overview): Param Region and Param Campaign, each with
// the 4th LanguageCode column and the DimLanguage relationship, so an axis or
// slicer bound to Param Region[Param Region] / Param Campaign[Param Campaign]
// automatically shows the FR or EN field depending on the language slicer -
// never a literal _FR/_EN column. Built via the modeling MCP's
// CreateFieldParameter + table_operations Update (to add LanguageCode) +
// relationship_operations Create (Param X[LanguageCode] -> DimLanguage[LanguageCode],
// one-direction); recalculate the model after creating the relationship.
Param Region = {
    ("Région", NAMEOF ( 'DimRegion'[RegionName_FR] ), 0, "FR"),
    ("Region", NAMEOF ( 'DimRegion'[RegionName_EN] ), 1, "EN")
}
Param Campaign = {
    ("Campagne", NAMEOF ( 'DimDate'[Campaign_FR] ), 0, "FR"),
    ("Campaign", NAMEOF ( 'DimDate'[Campaign_EN] ), 1, "EN")
}
Param Prefecture = {
    ("Préfecture", NAMEOF ( 'DimPrefecture'[PrefectureName_FR] ), 0, "FR"),
    ("Prefecture", NAMEOF ( 'DimPrefecture'[PrefectureName_EN] ), 1, "EN")
}
// Remaining field parameters below are TODO for page 3 (Clinical analysis).
