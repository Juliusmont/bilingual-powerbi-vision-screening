				    SELECTCOLUMNS ( SUMMARIZE ( DimDiagnosis, DimDiagnosis[GroupSortOrder], DimDiagnosis[DiagnosisGroup_EN] ), "Domain", "DIAG", "CatKey", DimDiagnosis[GroupSortOrder], "LanguageCode", "EN", "Label", DimDiagnosis[DiagnosisGroup_EN] ),
				    SELECTCOLUMNS ( DimVACategory, "Domain", "VA", "CatKey", DimVACategory[VACategoryKey], "LanguageCode", "FR", "Label", DimVACategory[VACategory_FR] ),
				    SELECTCOLUMNS ( DimVACategory, "Domain", "VA", "CatKey", DimVACategory[VACategoryKey], "LanguageCode", "EN", "Label", DimVACategory[VACategory_EN] ),
				    SELECTCOLUMNS ( DimSymptom, "Domain", "SYMPTOM", "CatKey", DimSymptom[SymptomKey], "LanguageCode", "FR", "Label", DimSymptom[Symptom_FR] ),
				    SELECTCOLUMNS ( DimSymptom, "Domain", "SYMPTOM", "CatKey", DimSymptom[SymptomKey], "LanguageCode", "EN", "Label", DimSymptom[Symptom_EN] ),
