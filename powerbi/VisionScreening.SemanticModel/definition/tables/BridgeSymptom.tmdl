table BridgeSymptom
	lineageTag: cbda7df2-1ca8-4845-9685-7a4c339bf4fb

	column StudentKey
		dataType: int64
		formatString: 0
		lineageTag: d80baf33-0b90-43a4-9869-f8d286b3bdec
		summarizeBy: none
		sourceColumn: StudentKey

		annotation SummarizationSetBy = Automatic

	column SymptomKey
		dataType: int64
		formatString: 0
		lineageTag: 3d71063c-e13b-4c86-9c35-bccae776d019
		summarizeBy: none
		sourceColumn: SymptomKey

		annotation SummarizationSetBy = Automatic

	partition BridgeSymptom = m
		mode: import
		source =
				let
				  Source = Csv.Document(File.Contents(DataFolder & "BridgeSymptom.csv"), [Delimiter = ",", Columns = 2, Encoding = 65001, QuoteStyle = QuoteStyle.None]),
				  #"Promoted headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				  #"Changed column type" = Table.TransformColumnTypes(#"Promoted headers", {{"StudentKey", Int64.Type}, {"SymptomKey", Int64.Type}}, "en-US")
				in
				  #"Changed column type"

	annotation PBI_ResultType = Table

