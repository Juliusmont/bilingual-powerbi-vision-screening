	measure 'Color YoY' =
			VAR d = [Students Screened YoY %]
			RETURN IF ( ISBLANK ( d ), "#4A5873", IF ( d >= 0, "#0CA30C", "#D03B3B" ) )
		displayFolder: 4 Formatted captions
		lineageTag: 8438850e-7bcc-41d6-9381-5a449bf8d6cc

	measure 'KPI Screened YoY Caption' =
			VAR d = [Students Screened YoY %]
			RETURN
			    IF (
			        ISBLANK ( d ),
			        IF ( [Selected Language] = "FR", "Première campagne", "First campaign" ),
			        ( IF ( d >= 0, "▲ ", "▼ " ) )
			            & FORMAT ( d, "+0.0%;-0.0%;0.0%", [Selected Locale] )
			            & IF ( [Selected Language] = "FR", " vs campagne précédente", " vs previous campaign" )
			    )
		displayFolder: 4 Formatted captions
		lineageTag: b0a21558-b640-4a85-8cae-97995b816687

	measure 'Color Target Achievement' =
			VAR a = [Target Achievement %]
			RETURN
			    IF (
			        ISBLANK ( a ), "#4A5873",
			        IF ( a >= 0.95, "#0CA30C", IF ( a >= 0.85, "#FAB219", "#D03B3B" ) )
			    )
		displayFolder: 4 Formatted captions
		lineageTag: b81068ca-e1cc-4001-94d3-5691fdeea275

	measure 'KPI Target Caption' =
			FORMAT ( [Target Students], "#,0", [Selected Locale] )
			    & IF ( [Selected Language] = "FR", " élèves ciblés", " students targeted" )
		displayFolder: 4 Formatted captions
		lineageTag: 72e74eac-3d76-44ea-9f16-f516dbd43a23

	measure 'KPI Uncorrected Caption' = IF ( [Selected Language] = "FR", "Parmi les besoins de correction", "Of those needing correction" )
		displayFolder: 4 Formatted captions
		lineageTag: 918c3050-1829-434d-b54b-a0b4198f1f10

	measure 'KPI Impairment Caption' = IF ( [Selected Language] = "FR", "Acuité légère ou pire, au moins un œil", "Mild acuity or worse, at least one eye" )
		displayFolder: 4 Formatted captions
		lineageTag: 249b1351-8316-4078-94fe-c41d9a2f935a

	measure 'Color Region Bar' = "#2A78D6"
		displayFolder: 4 Formatted captions
		lineageTag: bb640a6d-47c3-473a-9137-d6ba7cbdd3f1

	measure 'Header Campaign Pill' =
			VAR yr = SELECTEDVALUE ( DimDate[Year] )
			RETURN
			    IF (
			        ISBLANK ( yr ),
			        IF ( [Selected Language] = "FR", "Toutes campagnes", "All campaigns" ),
			        IF ( [Selected Language] = "FR", "Campagne " & yr, yr & " campaign" )
			    )
		displayFolder: 4 Formatted captions
		lineageTag: a7a53904-1afe-4de5-a034-7226173eb987

	measure 'Narrative Headline' =
			VAR need = [Correction Need Rate]
			VAR screened = [Students Screened]
			RETURN
			    IF (
			        [Selected Language] = "FR",
			        FORMAT ( need, "0.0%", "fr-FR" ) & " des " & FORMAT ( screened, "#,0", "fr-FR" )
			            & " élèves dépistés ont besoin d'une correction visuelle.",
			        FORMAT ( need, "0.0%", "en-US" ) & " of " & FORMAT ( screened, "#,0", "en-US" )
			            & " students screened need a vision correction."
			    )
		displayFolder: 4 Formatted captions
		lineageTag: 6039ab76-4b33-4439-bdf2-2d01ad7eeec9

	measure 'Diagnosis Share (Cat)' =
			VAR k = SELECTEDVALUE ( 'Lbl Cat'[CatKey] )
			RETURN
			    IF (
			        SELECTEDVALUE ( 'Lbl Cat'[LanguageCode] ) = [Selected Language] && NOT ISBLANK ( k ) && [Students Screened] >= 10,
			        CALCULATE ( [Diagnosis Share], DimDiagnosis[GroupSortOrder] = k )
			    )
		formatString: 0.0%
		displayFolder: 3 Clinical analysis
		lineageTag: a367987f-4732-4918-8568-2f8a7ed1adbc

	measure 'VA Share (Cat)' =
			VAR k = SELECTEDVALUE ( 'Lbl Cat'[CatKey] )
			RETURN
			    IF (
			        SELECTEDVALUE ( 'Lbl Cat'[LanguageCode] ) = [Selected Language] && NOT ISBLANK ( k ) && [Students Screened] >= 10,
			        DIVIDE ( CALCULATE ( [Eyes Examined], FactEyeExam[VACategoryKey] = k ), [Eyes Examined] )
			    )
		formatString: 0.0%
		displayFolder: 3 Clinical analysis
		lineageTag: affa98d6-852d-4bc3-960f-a6c994ee9339

	measure 'Symptom Rate (Cat)' =
			VAR k = SELECTEDVALUE ( 'Lbl Cat'[CatKey] )
			RETURN
			    IF (
			        SELECTEDVALUE ( 'Lbl Cat'[LanguageCode] ) = [Selected Language] && NOT ISBLANK ( k ) && [Students Screened] >= 10,
			        CALCULATE ( [Symptom Rate], DimSymptom[SymptomKey] = k )
