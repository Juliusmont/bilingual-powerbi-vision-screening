	measure 'Students Screened' = COUNTROWS ( FactScreening )
		formatString: #,##0
		displayFolder: 1 Core KPIs
		lineageTag: a44f2b12-b497-4001-9125-8bd47ab34086

	measure 'Eyes Examined' = COUNTROWS ( FactEyeExam )
		formatString: #,##0
		displayFolder: 1 Core KPIs
		lineageTag: 04135247-8d7c-41de-9c32-738f6e5e3b4d

	measure 'Students Needing Correction' = CALCULATE ( DISTINCTCOUNT ( FactEyeExam[StudentKey] ), FactEyeExam[SphereRx] <> 0 || FactEyeExam[CylinderRx] <> 0 )
		formatString: #,##0
		displayFolder: 1 Core KPIs
		lineageTag: 04082de7-95a7-4c15-a011-758ac4e9c862

	measure 'Correction Need Rate' = DIVIDE ( [Students Needing Correction], [Students Screened] )
		formatString: 0.0%
		displayFolder: 1 Core KPIs
		lineageTag: 598bc172-ad37-4d24-b4f3-a7a5c08a6ac9

	measure 'Uncorrected Need' = CALCULATE ( [Students Needing Correction], FactScreening[WearsCorrection] = 0 )
		formatString: #,##0
		displayFolder: 1 Core KPIs
		lineageTag: c4e14a16-c8c7-4fd7-b98a-e0d429092e0a

	measure 'Uncorrected Need Rate' = DIVIDE ( [Uncorrected Need], [Students Needing Correction] )
		formatString: 0.0%
		displayFolder: 1 Core KPIs
		lineageTag: bad292e9-b0ef-43c5-9507-7192d3a843d8

	measure 'Students With Impairment' = CALCULATE ( DISTINCTCOUNT ( FactEyeExam[StudentKey] ), FactEyeExam[VACategoryKey] >= 2 )
		formatString: #,##0
		displayFolder: 1 Core KPIs
		lineageTag: 3a9c6afe-7116-4b2b-a74a-f34f42fa8e3e

	measure 'Impairment Rate' = DIVIDE ( [Students With Impairment], [Students Screened] )
		formatString: 0.0%
		displayFolder: 1 Core KPIs
		lineageTag: eaf355d2-edb3-44e3-bf72-58eddb7de4ea

	measure 'Screen Exposure Rate' = DIVIDE ( CALCULATE ( [Students Screened], FactScreening[ScreenTimeKey] > 0 ), [Students Screened] )
		formatString: 0.0%
		displayFolder: 1 Core KPIs
		lineageTag: cf445c74-b3ef-44e0-a490-9491acaa9535

	measure 'Diagnosis Share' = DIVIDE ( [Eyes Examined], CALCULATE ( [Eyes Examined], REMOVEFILTERS ( DimDiagnosis ) ) )
		formatString: 0.0%
		displayFolder: 1 Core KPIs
		lineageTag: 1b91961b-fd8a-4350-9fd5-55d4406353f7

	measure 'Students With Symptom' = DISTINCTCOUNT ( BridgeSymptom[StudentKey] )
		formatString: #,##0
		displayFolder: 1 Core KPIs
		lineageTag: 304a6c2f-f279-49fb-8ca2-72798ed6df9c

	measure 'Symptom Rate' = DIVIDE ( [Students With Symptom], [Students Screened] )
		formatString: 0.0%
		displayFolder: 1 Core KPIs
		lineageTag: d1270334-41cb-4f0e-bfd2-4ef52f6c6c9f

	measure 'Students Screened PY' = CALCULATE ( [Students Screened], SAMEPERIODLASTYEAR ( DimDate[Date] ) )
		formatString: #,##0
		displayFolder: 2 Time intelligence & targets
		lineageTag: d5d882aa-b733-4417-97f9-4027c96b116c

	measure 'Students Screened YoY %' = DIVIDE ( [Students Screened] - [Students Screened PY], [Students Screened PY] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 2 Time intelligence & targets
		lineageTag: 52ff0317-2cd6-4fda-aab3-7e6595265dc2

	measure 'Students Screened YTD' = TOTALYTD ( [Students Screened], DimDate[Date] )
		formatString: #,##0
		displayFolder: 2 Time intelligence & targets
		lineageTag: 11bae57e-13bd-4824-89fc-33f5609783c8

	measure 'Correction Need Rate PY' = CALCULATE ( [Correction Need Rate], SAMEPERIODLASTYEAR ( DimDate[Date] ) )
		formatString: 0.0%
		displayFolder: 2 Time intelligence & targets
		lineageTag: 2b5225b4-5878-4d35-869b-6820383c9bb5

	measure 'Correction Need Rate Change (pts)' = IF ( NOT ISBLANK ( [Correction Need Rate PY] ), ( [Correction Need Rate] - [Correction Need Rate PY] ) * 100 )
		formatString: +0.0;-0.0;0.0
		displayFolder: 2 Time intelligence & targets
		lineageTag: 39d32b55-a788-47ac-bdf3-e995e8f0e479

	measure 'Target Students' = SUM ( FactTarget[TargetStudents] )
		formatString: #,##0
		displayFolder: 2 Time intelligence & targets
		lineageTag: 0cf2bd9d-71e3-41f6-bf1d-1ce1911ca47e

	measure 'Target Achievement %' = DIVIDE ( [Students Screened], [Target Students] )
		formatString: 0.0%
		displayFolder: 2 Time intelligence & targets
		lineageTag: 72598752-8f8d-4712-be6e-96137dff15af

	measure 'Prefecture Rank (Need Rate)' = IF ( ISINSCOPE ( DimPrefecture[Prefecture] ), RANKX ( ALLSELECTED ( DimPrefecture[Prefecture] ), [Correction Need Rate], , DESC, DENSE ) )
		formatString: 0
		displayFolder: 3 Ranking
		lineageTag: 9f909a96-e870-4ab7-a982-ff6fb9be0ada

	measure 'KPI Need Subtitle' =
			VAR d = [Correction Need Rate Change (pts)]
			RETURN
			    IF (
			        ISBLANK ( d ),
			        IF ( [Selected Language] = "FR", "Première campagne", "First campaign" ),
			        FORMAT ( d, "+0.0;-0.0;0.0", [Selected Locale] )
			            & IF ( [Selected Language] = "FR", " pts vs campagne précédente", " pts vs previous campaign" )
			    )
		displayFolder: 4 Formatted captions
		lineageTag: 9dba321c-71a6-4d15-9ac3-b2320f4d02a3

	measure 'KPI Screened Caption' =
			FORMAT ( [Students Screened], "#,0", [Selected Locale] )
			    & IF ( [Selected Language] = "FR", " élèves dépistés", " students screened" )
		displayFolder: 4 Formatted captions
		lineageTag: cb44d79c-5ce0-47f5-87b3-e18f8d119d13

	measure 'Alt Text Region Chart' =
			IF (
			    [Selected Language] = "FR",
			    "Graphique à barres du taux de besoin de correction par région. Taux national : "
			        & FORMAT ( [Correction Need Rate], "0.0 %", "fr-FR" ),
			    "Bar chart of the need-for-correction rate by region. National rate: "
			        & FORMAT ( [Correction Need Rate], "0.0%", "en-US" )
			)
		displayFolder: 4 Formatted captions
		lineageTag: 615c355e-1981-4e97-a4a3-ed694cba239d

	measure 'Correction Need Rate (Safe)' = IF ( [Students Screened] < 10, BLANK (), [Correction Need Rate] )
		formatString: 0.0%
		displayFolder: 5 Privacy
		lineageTag: c9ed9a73-5884-4e5d-be29-85c901743c44

	measure 'DQ Implausible Cylinder' = COUNTROWS ( FILTER ( FactEyeExam, ABS ( FactEyeExam[CylinderRx] ) > 6 ) )
		formatString: #,##0
		displayFolder: 6 Data integrity checks
		lineageTag: a06e4b54-2b4b-48e2-a145-20c8915f1d96

	measure 'DQ Plus Cylinder Convention' = COUNTROWS ( FILTER ( FactEyeExam, FactEyeExam[CylinderRx] > 0 && FactEyeExam[CylinderRx] <= 6 ) )
		formatString: #,##0
		displayFolder: 6 Data integrity checks
		lineageTag: b3c250d1-5471-414c-a725-73091790fe24

	measure 'DQ Missing Visual Acuity' = COUNTROWS ( FILTER ( FactEyeExam, ISBLANK ( FactEyeExam[VA_10] ) ) )
		formatString: #,##0
		displayFolder: 6 Data integrity checks
		lineageTag: 4cc67bc5-dc33-4cd7-92ae-4cd13c1b115f

	measure 'DQ Students Without Two Eyes' = COALESCE ( COUNTROWS ( FILTER ( FactScreening, CALCULATE ( COUNTROWS ( FactEyeExam ) ) <> 2 ) ), 0 )
		formatString: #,##0
		displayFolder: 6 Data integrity checks
		lineageTag: 9dc85514-fd51-4874-9f76-2d1cb383304a

	measure 'DQ Symptom Inconsistency' =
			COALESCE (
			    COUNTROWS (
			        FILTER ( FactScreening, FactScreening[HasSymptoms] = 0 && CALCULATE ( COUNTROWS ( BridgeSymptom ) ) > 0 )
			    ),
			    0
			)
		formatString: #,##0
		displayFolder: 6 Data integrity checks
		lineageTag: 947b5449-12e2-4ed6-a269-4790d3c83a3a

	measure 'DQ Issues Total' =
			[DQ Implausible Cylinder] + [DQ Plus Cylinder Convention] + [DQ Missing Visual Acuity]
			    + [DQ Students Without Two Eyes] + [DQ Symptom Inconsistency]
		formatString: #,##0
		displayFolder: 6 Data integrity checks
		lineageTag: 8853f348-1b08-4607-8131-353fedc1918b

	measure 'DQ Status' =
			IF (
			    [DQ Issues Total] = 0,
			    IF ( [Selected Language] = "FR", "✓ Aucune anomalie", "✓ No issues" ),
			    "⚠ " & FORMAT ( [DQ Issues Total], "#,0", [Selected Locale] )
			        & IF ( [Selected Language] = "FR", " anomalies à vérifier", " issues to review" )
			)
		displayFolder: 6 Data integrity checks
		lineageTag: 70436a49-56c9-49ba-87ce-e204acb9b39e

